# macOS
.DS_Store
._*

# Editor
.vscode/
.idea/
*.swp
*~

# Logs
*.log

# Env / secrets
.env
.env.*
!.env.example

# Heavy binaries — keep them in Drive, not git
clients/*/assets/master/
clients/*/assets/raw/
clients/*/assets/exports/
clients/*/03-media/raw/

# Oversized source decks handed to us by partners. They stay on local disk and
# in Drive, linked from the client's CLIENT.md, never in git history.
# Paths are one level deeper than the rules above because COO files its
# sub-clients as clients/COO/<client>/.
clients/COO/Colgate/01-strategy/COLGATE - COO Plan.pptx

# Common heavy file types under clients/<x>/assets/ — preview-size only in git
clients/*/assets/**/*.psd
clients/*/assets/**/*.ai
clients/*/assets/**/*.indd
clients/*/assets/**/*.aep
clients/*/assets/**/*.prproj
clients/*/assets/**/*.fig
clients/*/assets/**/*.mov
clients/*/assets/**/*.mp4
clients/*/assets/**/*.zip

# Build caches / local environments — never commit
.venv/
venv/
__pycache__/
*.pyc
node_modules/
.wrangler/

# Local-only scratch
**/scratch/
**/_local/
