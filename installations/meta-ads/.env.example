# Meta Ads credentials for this project. Copy to <project>/.env and fill in.
#
#   cp installations/meta-ads/.env.example .env
#
# .env is gitignored at the repo root. Never commit it, never paste a token into
# a chat session. If a token leaks, ROTATE it in Business Manager
# (System users -> the user -> Generate token). Deleting the line is not enough.
#
# Load it once per shell, then run commands:
#   source .env && meta auth status

# ---- One token per client -----------------------------------------------
# Each client gets its own Business Manager system user, assigned that client's
# ad account and nothing else. No token ever spans two clients, so an over
# assigned or leaked token cannot reach another client's numbers.
# Scope: ads_read only. Do not grant ads_management unless writes are wanted.

export ACCESS_TOKEN_UNITAR=""
export ACCESS_TOKEN_TOGGLE=""

# ---- Businesses ----------------------------------------------------------
# Business Manager ids. Not secrets, and not access: they only tell the
# discovery command which portfolio to look at.
#   meta business accounts --business "$META_BUSINESS_TOGGLE"
export META_BUSINESS_UNITAR="1936608196363281"   # Unitar
export META_BUSINESS_TOGGLE="596170808875972"    # Toggle Solutions

# ---- Accounts ------------------------------------------------------------
# One variable per in scope ad account. No default account, ever: every command
# names its account explicitly.
export ACT_UNITAR="act_1034316391892752"        # UNITAR (MYR) - Audaura
export ACT_TOGGLE="act_REPLACE_ME"              # Toggle Solutions

# Which token owns which account. An account listed here uses that profile's
# token only and never falls back to another one. bin/meta reads this to pick
# the credential for every account command.
export META_ACCOUNT_PROFILES="act_1034316391892752=UNITAR,act_REPLACE_ME=TOGGLE"

# Hard allowlist. Any account not listed here is refused by bin/meta, even if a
# token can see it. Keep this in sync with the ACT_* lines above.
export META_ALLOWED_ACCOUNTS="act_1034316391892752,act_REPLACE_ME"

# Optional: pin the Graph API version if the default in bin/meta-ads.py goes stale.
# export META_API_VERSION="v23.0"
