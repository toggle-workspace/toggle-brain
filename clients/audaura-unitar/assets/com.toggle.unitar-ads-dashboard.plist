<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily refresh of the UNITAR Meta ads creative dashboard.

  Install (one-time):
    cp "clients/audaura-unitar/assets/com.toggle.unitar-ads-dashboard.plist" \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.toggle.unitar-ads-dashboard.plist

  Deploy creds are read from assets/deploy.env by the refresh script (Cloudflare
  Pages), so no secrets live here.

  Runs every day at 07:30. Logs to the assets/logs directory.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.toggle.unitar-ads-dashboard</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zaidsaad/Desktop/Code/Toggle Brain/clients/audaura-unitar/assets/refresh-dashboard.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/zaidsaad/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/zaidsaad/Desktop/Code/Toggle Brain/clients/audaura-unitar/assets/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zaidsaad/Desktop/Code/Toggle Brain/clients/audaura-unitar/assets/logs/launchd.err.log</string>
</dict>
</plist>
