# Cloudflare Pages deploy credentials for the UNITAR dashboard.
# Copy this to `deploy.env` (gitignored) and fill in. NEVER commit the real deploy.env.
#
# One-time setup:
#   1. Create a free Cloudflare account (dash.cloudflare.com).
#   2. My Profile -> API Tokens -> Create Token -> use the "Edit Cloudflare Pages"
#      template (or a custom token with the Account · Cloudflare Pages · Edit permission).
#   3. Copy the token below, and your Account ID (Workers & Pages -> right sidebar,
#      or the hex string in any dashboard URL).
#
# The daily refresh sources this file and runs `wrangler pages deploy`.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=unitar-ads-dashboard
