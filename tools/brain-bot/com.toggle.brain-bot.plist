<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.toggle.brain-bot — keep the brain-bot listener running, and keep the Mac
  awake while it does (so it can answer when the lid is closed / overnight).

  Install:
    cp tools/brain-bot/com.toggle.brain-bot.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.toggle.brain-bot.plist
  Stop:
    launchctl unload -w ~/Library/LaunchAgents/com.toggle.brain-bot.plist

  caffeinate -dis keeps display(-d)/idle(-i)/system(-s) awake for the lifetime
  of the listener; KeepAlive respawns the bot if it ever crashes.

  caffeinate is invoked INSIDE run-bot.sh, not here. When this plist ran
  /usr/bin/caffeinate as the program and let it exec run-bot.sh, every launch
  died with "Operation not permitted" and KeepAlive spun on it: macOS decides
  TCC by the responsible process, and caffeinate has no grant for ~/Desktop,
  whereas /bin/bash exec'd directly by launchd does. Keep bash as the program.

  Log paths must live OUTSIDE ~/Desktop. launchd opens StandardOutPath and
  StandardErrorPath itself, before exec, and has no TCC grant for the protected
  Desktop / Documents / Downloads folders. Pointed into the repo, the job dies
  with EX_CONFIG (78) having never reached bash, and writes nothing anywhere.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.toggle.brain-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/zaidsaad/Desktop/Code/Toggle Brain/tools/brain-bot/run-bot.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/zaidsaad/Library/Logs/brain-bot/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zaidsaad/Library/Logs/brain-bot/launchd.err.log</string>
</dict>
</plist>
