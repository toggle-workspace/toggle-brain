# Meta Ads CLI credentials — copy to `.env` and fill in. NEVER commit the real .env.
# (.env / .env.* are gitignored at the repo root; only this .env.example is tracked.)
#
# How to load these before using `meta`:
#   set -a; source tools/meta-ads-cli/.env; set +a
#
# How to generate (see README.md "Authentication" for the full walkthrough):
#   Business Manager → System User → generate token with:
#   ads_management, ads_read, business_management, pages_show_list

# Long-lived System User access token (treat like a password)
ACCESS_TOKEN=

# Ad account ID, with the act_ prefix, e.g. act_1234567890
AD_ACCOUNT_ID=
